# Environment
APP_ENV=development
APP_URL=http://localhost:5173
APP_NAME=Patron

# Runtime role URL (pooled Neon connection string for app_user)
DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Migration owner URL (direct Neon connection string; never expose to client code)
DATABASE_URL_MIGRATE=postgresql://YOUR_OWNER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Only used by scripts/provision-app-role.mjs; keep this secret out of source control.
APP_USER_PASSWORD=replace-with-a-long-random-password
