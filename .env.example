# Environment
APP_ENV=development
APP_URL=http://localhost:5173
APP_NAME=Patron

# Runtime role URL (pooled Neon connection string for app_user)
DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Migration owner URL (direct Neon connection string; never expose to client code)
DATABASE_URL_MIGRATE=postgresql://YOUR_OWNER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Only used by scripts/provision-app-role.mjs; keep this secret out of source control.
APP_USER_PASSWORD=replace-with-a-long-random-password

# Data source: demo (browser repo, default) or live (Neon via withContext).
DATA_MODE=demo
# Dev-branch pooled app_user URL for seeding/tests. Never point at production.
DATABASE_URL_DEV=
# Production database hostname. The dev seed refuses any target with this host.
PROD_DB_HOST=
# Confirm flag for the dev seed script (dev branch only).
# DEV_SEED_CONFIRM=yes
# SEED_BRANCH=vercel-dev
# Till PIN pepper (HMAC). Dev default is the demo pepper; set a real one per env.
# PIN_PEPPER=
# Server-side HMAC secret for the 60-second QR card tokens. Live mode fails closed without it.
# SCAN_TOKEN_SECRET=

# Demo SMS provider: console|fake|smssouthafrica|sendmode. The last two are
# stubs that throw until the founder picks a provider (see docs/decisions.md).
SMS_PROVIDER=fake

# BulkSMS.com (chosen provider). Create an API token in the BulkSMS web app. Never commit real values.
# Put these in .dev.vars locally and `wrangler secret put` on staging/production.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# Random string; add it to your webhook URLs as ?secret=<value> (BulkSMS does not sign requests).
SMS_WEBHOOK_SECRET=
# Registered sender ID or number. Leave blank until you know what your account allows.
SMS_DEFAULT_SENDER=

# Self-hosted Better Auth (Phase D1). Put real values only in .dev.vars or
# Worker secrets, never here and never in chat.
# BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
# BETTER_AUTH_URL=http://127.0.0.1:5174
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_EMAIL_WEBHOOK_URL=
# AUTH_EMAIL_WEBHOOK_SECRET=
# Set to 1 only when Google OAuth is configured for this environment.
# VITE_AUTH_GOOGLE=0
