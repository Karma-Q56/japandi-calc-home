# Environment
APP_ENV=development
APP_URL=http://localhost:5173
APP_NAME=Patron

# Runtime role URL (pooled Neon connection string for app_user)
DATABASE_URL=postgresql://app_user:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Migration owner URL (direct Neon connection string; never expose to client code)
DATABASE_URL_MIGRATE=postgresql://YOUR_OWNER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DATABASE?sslmode=require

# Only used by scripts/provision-app-role.mjs; keep this secret out of source control.
APP_USER_PASSWORD=replace-with-a-long-random-password

# Demo SMS provider: console|fake|smssouthafrica|sendmode. The last two are
# stubs that throw until the founder picks a provider (see docs/decisions.md).
SMS_PROVIDER=fake

# BulkSMS.com (chosen provider). Create an API token in the BulkSMS web app. Never commit real values.
# Put these in .dev.vars locally and `wrangler secret put` on staging/production.
BULKSMS_TOKEN_ID=
BULKSMS_TOKEN_SECRET=
# Random string; add it to your webhook URLs as ?secret=<value> (BulkSMS does not sign requests).
SMS_WEBHOOK_SECRET=
# Registered sender ID or number. Leave blank until you know what your account allows.
SMS_DEFAULT_SENDER=
